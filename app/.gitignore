# Dart / Flutter
.dart_tool/
.packages
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies

# Resolved dependency versions are produced by `flutter pub get`. This repository
# is authored without a Dart SDK, so the lock file is generated by CI rather than
# committed by hand; committing a hand-written one would be a fabrication.
pubspec.lock

# Android
android/local.properties
android/.gradle/
android/captures/
android/.cxx/

# The Gradle wrapper (gradlew, gradlew.bat and gradle/wrapper/) is injected by the
# Flutter tool on first build. A wrapper properties file without its matching jar
# breaks that injection, so neither is committed.
android/gradlew
android/gradlew.bat
android/gradle/

# Signing material never enters this repository.
android/key.properties
*.jks
*.keystore

# Editors
.idea/
*.iml
.vscode/
