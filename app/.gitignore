# Dart / Flutter
.dart_tool/
.packages
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies

# pubspec.lock is NOT ignored. This is an application, not a library, so the
# resolved versions belong in the repository - that is what makes two builds of
# the same commit the same build. It was ignored here while there was no way to
# produce one honestly (no Dart SDK in the authoring environment, and a
# hand-written lock file would have been a fabrication), which quietly
# contradicted the root .gitignore saying it is committed. The CI job that
# resolves dependencies now commits it, so the rule can say what it means.

# Android
android/local.properties
android/.gradle/
android/captures/
android/.cxx/

# The Flutter tool injects the Gradle wrapper on first build, copying any wrapper
# file that is missing one at a time. So the launcher scripts and the binary jar
# are left to the tool, while gradle-wrapper.properties is committed to pin the
# Gradle version -- Flutter's injected default is 8.9.0, which is below the 8.14.0
# its own Gradle plugin requires.
android/gradlew
android/gradlew.bat
# Only the binary jar and the launcher scripts are excluded. gradle-wrapper.properties
# IS committed: it pins the Gradle version, and the Flutter tool fills in the rest
# file by file.
android/gradle/wrapper/gradle-wrapper.jar

# Signing material never enters this repository.
android/key.properties
*.jks
*.keystore

# Editors
.idea/
*.iml
.vscode/
