# secrets — never commit
.env
*.env
!.env.example
key.properties
*.jks
*.keystore
service-account*.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# flutter / dart
app/.dart_tool/
app/.flutter-plugins*
app/build/
# pubspec.lock IS committed for an app -- it is what makes a build reproducible.
# It does not exist yet because there is no Dart SDK in the authoring environment;
# commit the one the first green CI run produces.
app/android/local.properties
app/android/.gradle/
app/android/app/debug/
app/android/app/release/
# The Flutter tool injects any wrapper file that is missing, one file at a time, so
# the version can be pinned in gradle-wrapper.properties (which IS committed) while
# the script and the binary jar are left to the tool.
app/android/gradlew
app/android/gradlew.bat
app/android/gradle/wrapper/gradle-wrapper.jar

# personal health data — must never be committed
samples/*
!samples/README.md

# editors / os
.idea/
.vscode/
.DS_Store
