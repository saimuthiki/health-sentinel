# Copy to .env for local development. NEVER commit a filled-in copy.
# In production these are set in the Render dashboard, not in a file.

# --- Google Gemini (from aistudio.google.com) ---------------------------------
GEMINI_API_KEY=

# Per-task model overrides. Names match app/ai/routing.py Task members.
# Read at call time, so changing one here needs no code change.
GEMINI_MODEL_EXTRACT_REPORT=gemini-2.5-flash
GEMINI_MODEL_CHAT=gemini-2.5-flash
GEMINI_MODEL_PLAN_DAY=gemini-2.5-flash
GEMINI_MODEL_PLAN_WEEK=gemini-2.5-pro
GEMINI_MODEL_WEEKLY_REVIEW=gemini-2.5-pro
GEMINI_MODEL_SAFETY_JUDGE=gemini-2.5-flash

# --- Supabase (Project Settings -> API) ---------------------------------------
# Project URL, e.g. https://your-project-ref.supabase.co
# Everything else is built from it: the sign-in key list, the token issuer, the
# database URL and the file storage URL. The project reference is never written
# anywhere else in the code.
SUPABASE_URL=

# Publishable key (older projects call it "anon"). Safe to ship in the mobile app.
# The backend sends it alongside the USER's own sign-in token, so the database
# runs each query as that user and Row Level Security does the protecting.
SUPABASE_ANON_KEY=

# service_role / secret key. Bypasses Row Level Security. Backend only, never in
# the app, never in this repository. Used for exactly two jobs: deleting a user's
# data when they ask to be forgotten, and closing off the deletion receipt.
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL, and only for the key rotation window. Leave it EMPTY.
#
# Supabase now signs sign-in tokens with a public/private key pair (ES256), and the
# backend checks each token against the public keys Supabase publishes at
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json -- no secret needed, and a key can be
# rotated without touching this file.
#
# The old scheme used one shared secret (HS256). Tokens issued before the switch are
# still valid until they expire. Setting this variable tells the backend to keep
# accepting those older tokens; it logs a warning every time it does. Once every old
# token has expired -- an hour or so after the switch, a week to be safe -- delete
# this variable. A shared secret you no longer need is just a secret that can leak.
SUPABASE_JWT_SECRET=

# Private bucket holding uploaded report files.
SUPABASE_STORAGE_BUCKET=reports

# --- Optional -----------------------------------------------------------------
USDA_API_KEY=

# --- Runtime ------------------------------------------------------------------
# development | test | staging | production. In production the service refuses to
# start unless SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY and GEMINI_API_KEY are
# all set, and it names every one that is missing.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated web origins allowed to call the API. The mobile app does not need
# this; leave it empty unless a browser is calling the API.
CORS_ALLOW_ORIGINS=

# Largest report file accepted, in bytes. 20 MB.
MAX_UPLOAD_BYTES=20971520
