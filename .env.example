# Copy to .env for local development. NEVER commit a filled-in copy.
# In production these are set in the Render dashboard, not in a file.

# --- Google Gemini (from aistudio.google.com) ---------------------------------
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACT=gemini-2.5-flash
GEMINI_MODEL_CHAT=gemini-2.5-flash
GEMINI_MODEL_PLAN=gemini-2.5-flash
GEMINI_MODEL_REVIEW=gemini-2.5-pro

# --- Supabase (Project Settings -> API) ---------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Optional -----------------------------------------------------------------
USDA_API_KEY=

# --- Runtime ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
